# Copy this file to .env.local and fill in the values to turn on
# booking confirmation emails. Without it the site still works, emails
# are just skipped.

# From sendgrid.com -> Settings -> API Keys -> Create API Key
SENDGRID_API_KEY=paste-your-key-here

# The sender address you verified in SendGrid (Settings -> Sender
# Authentication -> Verify a Single Sender). Until a real domain exists,
# your own email works fine.
BOOKING_FROM_EMAIL=you@example.com
