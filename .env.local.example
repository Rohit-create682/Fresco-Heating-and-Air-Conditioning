# Copy this file to .env.local and fill in the values to turn on
# booking confirmation emails. Without it the site still works, emails
# are just skipped.

# --- Brevo (primary, free tier 300 emails/day) ---
# From brevo.com -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=paste-your-key-here

# --- SendGrid (fallback, only used when no Brevo key is set) ---
# From sendgrid.com -> Settings -> API Keys -> Create API Key
# SENDGRID_API_KEY=paste-your-key-here

# The sender address verified with the provider (Brevo: Senders & IP,
# SendGrid: Sender Authentication -> Verify a Single Sender). Until a
# real domain exists, your own email works fine.
BOOKING_FROM_EMAIL=you@example.com
